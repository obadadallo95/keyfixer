{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["chrome"],
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": [
    "extension/src/**/*.ts",
    "src/core/keyboard/**/*.ts"
  ]
}
